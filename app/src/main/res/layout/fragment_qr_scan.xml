<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E2E2E">

    <include
        android:id="@+id/header"
        layout="@layout/view_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top icons below header -->
    <ImageView
        android:id="@+id/btnRefresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_flash_off"
        android:padding="12dp"
        app:tint="#FFFFFF"
        android:contentDescription="@null"
        app:layout_constraintEnd_toStartOf="@+id/btnSwitchCard"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <ImageView
        android:id="@+id/btnSwitchCard"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:src="@drawable/ic_badge"
        android:padding="12dp"
        app:tint="#FFFFFF"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnRefresh"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <FrameLayout
        android:id="@+id/qrPreviewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/btnRefresh"
        app:layout_constraintBottom_toTopOf="@id/bottomActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- The actual preview view gets injected dynamically here via QrScanFragment -->
    </FrameLayout>

    <!-- The target bounds -->
    <ImageView
        android:id="@+id/overlayBrackets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="@id/qrPreviewContainer"
        app:layout_constraintBottom_toBottomOf="@id/qrPreviewContainer"
        app:layout_constraintStart_toStartOf="@id/qrPreviewContainer"
        app:layout_constraintEnd_toEndOf="@id/qrPreviewContainer"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/capture_qr_brackets" />

    <!-- Animated Scanning Beam -->
    <View
        android:id="@+id/scanBeam"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/scan_beam_gradient"
        app:layout_constraintTop_toTopOf="@id/overlayBrackets"
        app:layout_constraintStart_toStartOf="@id/overlayBrackets"
        app:layout_constraintEnd_toEndOf="@id/overlayBrackets"
        android:visibility="visible" />

    <!-- Top scrim -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="@id/qrPreviewContainer"
        app:layout_constraintBottom_toTopOf="@id/overlayBrackets"
        app:layout_constraintStart_toStartOf="@id/qrPreviewContainer"
        app:layout_constraintEnd_toEndOf="@id/qrPreviewContainer" />

    <!-- Bottom scrim -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        app:layout_constraintTop_toBottomOf="@id/overlayBrackets"
        app:layout_constraintBottom_toBottomOf="@id/qrPreviewContainer"
        app:layout_constraintStart_toStartOf="@id/qrPreviewContainer"
        app:layout_constraintEnd_toEndOf="@id/qrPreviewContainer" />

    <!-- Left scrim -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="@id/overlayBrackets"
        app:layout_constraintBottom_toBottomOf="@id/overlayBrackets"
        app:layout_constraintStart_toStartOf="@id/qrPreviewContainer"
        app:layout_constraintEnd_toStartOf="@id/overlayBrackets" />

    <!-- Right scrim -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="@id/overlayBrackets"
        app:layout_constraintBottom_toBottomOf="@id/overlayBrackets"
        app:layout_constraintStart_toEndOf="@id/overlayBrackets"
        app:layout_constraintEnd_toEndOf="@id/qrPreviewContainer" />

    <FrameLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="129dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <include layout="@layout/view_bottom_actions_scan_card" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
